# ==============================================================================
# Smart Home Monitoring & Access Monitoring System Configuration
# ==============================================================================

# Flask Session & Security Key
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string"

# Database Configuration (SQLite default)
DATABASE_URL="sqlite:///smart_home_security.db"

# Admin Initial Setup (used by scripts/create_admin.py)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMeSecurely123!"

# Optional Cloud AI Assistant (Google Gemini Free Tier)
# Get a free key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_ENABLED="false"

# Camera & Detection Settings
CAMERA_INDEX=0
DETECTION_THRESHOLD=0.50
RECOGNITION_THRESHOLD=0.60
FRAME_INTERVAL=3
COOLDOWN_SECONDS=45
SOUND_ENABLED="true"
RETENTION_DAYS=30

# Network & Host
PORT=5001
HOST="0.0.0.0"
